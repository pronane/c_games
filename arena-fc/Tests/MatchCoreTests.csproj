<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure-C# regression suite for the deterministic match core.  The net layer
       is now restored, so Match.Network.cs (the partial MatchEngine with the
       checkpoint / networked-tick APIs) must be compiled alongside Match.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="MatchCoreTests.cs" />
    <Compile Include="../Scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
