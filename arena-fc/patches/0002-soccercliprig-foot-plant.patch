+    /// <summary>Compose local transforms from <paramref name="node"/> up to
+    /// <paramref name="ancestor"/> (exclusive of ancestor). Used when GlobalTransform
+    /// is unavailable because the hierarchy is not yet in the scene tree.</summary>
+    private static Transform3D TransformRelativeTo(Node3D ancestor, Node3D node)
+    {
+        Transform3D t = Transform3D.Identity;
+        Node? n = node;
+        while (n != null && n != ancestor)
+        {
+            if (n is Node3D n3)
+                t = n3.Transform * t;
+            n = n.GetParent();
+        }
+        return t;
+    }
 
